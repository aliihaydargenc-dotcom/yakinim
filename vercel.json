{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "*": true,
      "main": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self)"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "functions": {
    "api/overture.js": {
      "maxDuration": 60
    },
    "api/nearby.js": {
      "maxDuration": 60
    },
    "api/viewport.js": {
      "maxDuration": 30
    },
    "api/duty.js": {
      "maxDuration": 30
    },
    "api/news.js": {
      "maxDuration": 15
    },
    "api/radio.js": {
      "maxDuration": 30
    },
    "api/transit.js": {
      "maxDuration": 60
    },
    "api/prices.js": {
      "maxDuration": 30
    },
    "api/events.js": {
      "maxDuration": 30
    },
    "api/location.js": {
      "maxDuration": 15
    },
    "api/weather.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/traffic",
      "destination": "/api/transit?service=traffic"
    }
  ]
}
