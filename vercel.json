{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "*": true,
      "main": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self \"https://yandex.com.tr\")"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "functions": {
    "api/nearby.js": {
      "maxDuration": 60
    },
    "api/viewport.js": {
      "maxDuration": 30
    },
    "api/duty.js": {
      "maxDuration": 30
    },
    "api/news.js": {
      "maxDuration": 15
    },
    "api/radio.js": {
      "maxDuration": 30
    },
    "api/transit.js": {
      "maxDuration": 60
    },
    "api/prices.js": {
      "maxDuration": 30
    },
    "api/events.js": {
      "maxDuration": 30
    },
    "api/outages.js": {
      "maxDuration": 60
    },
    "api/fishing.js": {
      "maxDuration": 30
    },
    "api/location.js": {
      "maxDuration": 15
    }
  }
}
