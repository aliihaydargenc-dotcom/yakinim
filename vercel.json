{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self)"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "functions": {
    "api/nearby.js": {
      "maxDuration": 60
    },
    "api/viewport.js": {
      "maxDuration": 30
    },
    "api/news.js": {
      "maxDuration": 15
    },
    "api/radio.js": {
      "maxDuration": 20
    }
  }
}
